{
  "$schema": "./_schema/entity.v1.schema.json",
  "entity": {
    "id": "SYNCOP",
    "title": "SyncOperation",
    "description": "A single execution of the synchronization process."
  },
  "rule_set": {
    "version": "0.4.0",
    "timestamp": "2026-11-09T10:23:48Z",
    "hash": "blake3:ae2377a9d3559925d7824a5c19ea6f0bd1f01a405060098be9be5f969a3d7b47"
  },
  "rules": [
    {
      "id": "SYNCOP-001",
      "revision": 0,
      "state": "D",
      "body": "IS a single execution of the synchronization process.",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "SYNCOP-002",
      "revision": 0,
      "state": "D",
      "body": "HAS a UUID.",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "SYNCOP-003",
      "revision": 0,
      "state": "D",
      "body": "HAS a trigger type which MUST be one of: \"push\", \"manual\", \"schedule\".",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "SYNCOP-004",
      "revision": 0,
      "state": "D",
      "body": "HAS a UTC timestamp.",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "SYNCOP-005",
      "revision": 0,
      "state": "D",
      "body": "HAS a status which MUST be one of: \"pending\", \"running\", \"completed\", \"failed\".",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "SYNCOP-006",
      "revision": 1,
      "state": "D",
      "body": "MUST produce one or more SyncPullRequests for out-of-date repositories.",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "SYNCOP-007",
      "revision": 0,
      "state": "I",
      "body": "MAY operate in dry-run mode where no PRs are created or updated.",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "SYNCOP-008",
      "revision": 0,
      "state": "P",
      "body": "MUST record results in the DeploymentState.",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    }
  ],
  "sub_entities": [
    {
      "$schema": "./_schema/entity.v1.schema.json",
      "entity": {
        "id": "SYNCPR",
        "title": "SyncPullRequest",
        "description": "A pull request created in a target repository to deliver a template update.",
        "parent": "SYNCOP"
      },
      "rule_set": {
        "version": "0.7.0",
        "timestamp": "2026-11-09T10:23:48Z",
        "hash": "blake3:2bb0adb530c45be2ee66e881777ebf827a8aeee5b9f5f059fe5901c463d0951d"
      },
      "rules": [
        {
          "id": "SYNCPR-001",
          "revision": 0,
          "state": "D",
          "body": "IS a pull request created in a target repository to deliver a template update.",
          "added_by": "github:pleberre",
          "added_at": "2026-03-07",
          "supersedes": null
        },
        {
          "id": "SYNCPR-002",
          "revision": 0,
          "state": "I",
          "body": "MUST use a branch name in the format `steerspec-sync/<template-id>/<version>`.",
          "added_by": "github:pleberre",
          "added_at": "2026-03-07",
          "supersedes": null
        },
        {
          "id": "SYNCPR-003",
          "revision": 0,
          "state": "I",
          "body": "The PR body MUST include: previous version, new version, changelog, and diff link.",
          "added_by": "github:pleberre",
          "added_at": "2026-03-07",
          "supersedes": null
        },
        {
          "id": "SYNCPR-004",
          "revision": 0,
          "state": "D",
          "body": "MUST be labeled with a configurable label (default: `steerspec-sync`).",
          "added_by": "github:pleberre",
          "added_at": "2026-03-07",
          "supersedes": null
        },
        {
          "id": "SYNCPR-005",
          "revision": 0,
          "state": "P",
          "body": "MUST update an existing open PR for the same template rather than creating a duplicate.",
          "added_by": "github:pleberre",
          "added_at": "2026-03-07",
          "supersedes": null
        },
        {
          "id": "SYNCPR-006",
          "revision": 0,
          "state": "P",
          "body": "MUST close stale version PRs for the same template when a newer version PR is created.",
          "added_by": "github:pleberre",
          "added_at": "2026-03-07",
          "supersedes": null
        }
      ],
      "notes": [
        {
          "id": "SYNCPR-005/01",
          "rule_ref": "SYNCPR-005",
          "type": "rationale",
          "content": "This follows the Dependabot pattern of updating PRs in place to avoid PR flooding.",
          "added_by": "github:pleberre",
          "added_at": "2026-03-07",
          "revision": 0
        }
      ]
    }
  ],
  "notes": []
}
