{
  "$schema": "./_schema/entity.v1.schema.json",
  "entity": {
    "id": "SYNCOP",
    "title": "SyncOperation",
    "description": "A single execution of the synchronization process."
  },
  "rule_set": {
    "version": "0.7.2",
    "timestamp": "2026-11-14T10:41:28Z",
    "hash": "blake3:afe084a77ce9c307a28d6b4c34bd3b967f24b90430b77ed92dc2d81bf6e68ea0"
  },
  "rules": [
    {
      "id": "SYNCOP-001",
      "revision": 0,
      "state": "D",
      "body": "IS a single execution of the synchronization process.",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "SYNCOP-002",
      "revision": 0,
      "state": "D",
      "body": "HAS a UUID.",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "SYNCOP-003",
      "revision": 0,
      "state": "D",
      "body": "HAS a trigger type which MUST be one of: \"push\", \"manual\", \"schedule\".",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "SYNCOP-004",
      "revision": 0,
      "state": "D",
      "body": "HAS a UTC timestamp.",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "SYNCOP-005",
      "revision": 0,
      "state": "D",
      "body": "HAS a status which MUST be one of: \"pending\", \"running\", \"completed\", \"failed\".",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "SYNCOP-006",
      "revision": 1,
      "state": "D",
      "body": "MUST produce one or more SyncPullRequests for out-of-date repositories.",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "SYNCOP-007",
      "revision": 0,
      "state": "I",
      "body": "MAY operate in dry-run mode where no PRs are created or updated.",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "SYNCOP-008",
      "revision": 0,
      "state": "T",
      "body": "MUST record results in the DeploymentState.",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "SYNCOP-009",
      "revision": 0,
      "state": "I",
      "body": "MUST record results in the DeploymentState, except in dry-run mode, which MUST NOT write it.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-09",
      "supersedes": "SYNCOP-008"
    }
  ],
  "sub_entities": [
    {
      "$schema": "./_schema/entity.v1.schema.json",
      "entity": {
        "id": "SYNCPR",
        "title": "SyncPullRequest",
        "description": "A pull request created in a target repository to deliver a template update.",
        "parent": "SYNCOP"
      },
      "rule_set": {
        "version": "0.11.1",
        "timestamp": "2026-11-14T10:41:28Z",
        "hash": "blake3:87a648124d6eb01bfbc0726c5b4e693c8601f9472e94548c85cb7ab0801f1f83"
      },
      "rules": [
        {
          "id": "SYNCPR-001",
          "revision": 0,
          "state": "D",
          "body": "IS a pull request created in a target repository to deliver a template update.",
          "added_by": "github:pleberre",
          "added_at": "2026-03-07",
          "supersedes": null
        },
        {
          "id": "SYNCPR-002",
          "revision": 0,
          "state": "I",
          "body": "MUST use a branch name in the format `steerspec-sync/<template-id>/<version>`.",
          "added_by": "github:pleberre",
          "added_at": "2026-03-07",
          "supersedes": null
        },
        {
          "id": "SYNCPR-003",
          "revision": 0,
          "state": "I",
          "body": "The PR body MUST include: previous version, new version, changelog, and diff link.",
          "added_by": "github:pleberre",
          "added_at": "2026-03-07",
          "supersedes": null
        },
        {
          "id": "SYNCPR-004",
          "revision": 1,
          "state": "D",
          "body": "MUST be labeled with a configurable label (default: `steerspec-sync`) when it is created.",
          "added_by": "github:pleberre",
          "added_at": "2026-03-07",
          "supersedes": null
        },
        {
          "id": "SYNCPR-005",
          "revision": 0,
          "state": "I",
          "body": "MUST update an existing open PR for the same template rather than creating a duplicate.",
          "added_by": "github:pleberre",
          "added_at": "2026-03-07",
          "supersedes": null
        },
        {
          "id": "SYNCPR-006",
          "revision": 0,
          "state": "T",
          "body": "MUST close stale version PRs for the same template when a newer version PR is created.",
          "added_by": "github:pleberre",
          "added_at": "2026-03-07",
          "supersedes": null
        },
        {
          "id": "SYNCPR-007",
          "revision": 0,
          "state": "I",
          "body": "MUST close stale version PRs for the same template when a newer version PR is created (configurable via `close-stale-prs`).",
          "added_by": "github:pleberre",
          "added_at": "2026-11-09",
          "supersedes": "SYNCPR-006"
        }
      ],
      "notes": [
        {
          "id": "SYNCPR-005/01",
          "rule_ref": "SYNCPR-005",
          "type": "rationale",
          "content": "This follows the Dependabot pattern of updating PRs in place to avoid PR flooding.",
          "added_by": "github:pleberre",
          "added_at": "2026-03-07",
          "revision": 0
        }
      ]
    }
  ],
  "notes": []
}
