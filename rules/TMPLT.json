{
  "$schema": "./_schema/entity.v1.schema.json",
  "entity": {
    "id": "TMPLT",
    "title": "Template",
    "description": "A managed file synchronized to target repositories."
  },
  "rule_set": {
    "version": "0.7.1",
    "timestamp": "2026-11-09T21:52:18Z",
    "hash": "blake3:76b411b6153c72313c964693c581cb68e9c154a246d1aff7afaec0a32cf570d7"
  },
  "rules": [
    {
      "id": "TMPLT-001",
      "revision": 0,
      "state": "D",
      "body": "IS a managed file synchronized to target repositories.",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "TMPLT-002",
      "revision": 1,
      "state": "P",
      "body": "HAS a unique template identifier.",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "TMPLT-003",
      "revision": 0,
      "state": "P",
      "body": "HAS a type which MUST be one of: \"claude-md\", \"skill\", \"agent\", \"config\", \"custom\".",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "TMPLT-004",
      "revision": 2,
      "state": "D",
      "body": "A source IS a path relative to the central repository, or an owner/repo:path reference to another repository.",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "TMPLT-005",
      "revision": 0,
      "state": "D",
      "body": "HAS a destination path relative to the target repository (supports `.claude/` tree paths).",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "TMPLT-006",
      "revision": 0,
      "state": "P",
      "body": "MUST support a rendering strategy which MUST be one of: \"mustache\", \"marker\", \"full-replace\".",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "TMPLT-007",
      "revision": 0,
      "state": "P",
      "body": "When using the marker strategy, managed sections MUST be delimited by `<!-- STEERSPEC:BEGIN:section_name -->` and `<!-- STEERSPEC:END:section_name -->`.",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "TMPLT-008",
      "revision": 0,
      "state": "D",
      "body": "MAY define template-specific variables.",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "TMPLT-009",
      "revision": 1,
      "state": "D",
      "body": "When using the marker strategy, content outside the template's own managed sections belongs to the target repository, and once the deployment state records the template's sections, drift detection MUST compare only those sections.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "TMPLT-010",
      "revision": 0,
      "state": "P",
      "body": "MAY declare a source per target visibility (public, internal, private), with the plain source as the fallback.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    },
    {
      "id": "TMPLT-011",
      "revision": 0,
      "state": "P",
      "body": "MUST have at least one source, plain or per target visibility.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-07",
      "supersedes": null
    }
  ],
  "sub_entities": [
    {
      "$schema": "./_schema/entity.v1.schema.json",
      "entity": {
        "id": "TMPLTVRS",
        "title": "TemplateVersion",
        "description": "A versioned snapshot of a template's content.",
        "parent": "TMPLT"
      },
      "rule_set": {
        "version": "0.2.0",
        "timestamp": "2026-11-09T21:52:18Z",
        "hash": "blake3:c021df1e0886917790595732c9d0b440ce20816baff6578cf61486916a609090"
      },
      "rules": [
        {
          "id": "TMPLTVRS-001",
          "revision": 0,
          "state": "P",
          "body": "HAS a version in semver format (MAJOR.MINOR.PATCH).",
          "added_by": "github:pleberre",
          "added_at": "2026-03-07",
          "supersedes": null
        },
        {
          "id": "TMPLTVRS-002",
          "revision": 0,
          "state": "D",
          "body": "HAS a Blake3 hash of the template content.",
          "added_by": "github:pleberre",
          "added_at": "2026-03-07",
          "supersedes": null
        },
        {
          "id": "TMPLTVRS-003",
          "revision": 0,
          "state": "D",
          "body": "HAS a UTC timestamp.",
          "added_by": "github:pleberre",
          "added_at": "2026-03-07",
          "supersedes": null
        },
        {
          "id": "TMPLTVRS-004",
          "revision": 0,
          "state": "D",
          "body": "MUST be immutable once created.",
          "added_by": "github:pleberre",
          "added_at": "2026-03-07",
          "supersedes": null
        },
        {
          "id": "TMPLTVRS-005",
          "revision": 0,
          "state": "D",
          "body": "IS tracked via git tags in the format `tmpl/<template-id>/v<version>`.",
          "added_by": "github:pleberre",
          "added_at": "2026-03-07",
          "supersedes": null
        }
      ],
      "notes": []
    }
  ],
  "notes": [
    {
      "id": "TMPLT-006/01",
      "rule_ref": "TMPLT-006",
      "type": "rationale",
      "content": "Mustache is best for fully templated files. Marker is best for CLAUDE.md files where repos may have local sections between managed markers. Full-replace is best for agents and skills that should be identical everywhere.",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "revision": 0
    },
    {
      "id": "TMPLT-002/01",
      "rule_ref": "TMPLT-002",
      "type": "example",
      "content": "`claude-md` or `agent-code-review`",
      "added_by": "github:pleberre",
      "added_at": "2026-11-01",
      "revision": 0
    }
  ]
}
