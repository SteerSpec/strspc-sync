{
  "$schema": "./_schema/entity.v1.schema.json",
  "entity": {
    "id": "SYNCMFST",
    "title": "SyncManifest",
    "description": "The central configuration for synchronizing AI configuration files across a GitHub organization."
  },
  "rule_set": {
    "version": "0.1.5",
    "timestamp": "2026-11-12T12:07:50Z",
    "hash": "blake3:b0699551dcc74c7c5132a77502cc82515d62159bcd4473381d71a4accb623281"
  },
  "rules": [
    {
      "id": "SYNCMFST-001",
      "revision": 0,
      "state": "D",
      "body": "IS the central configuration for synchronizing AI configuration files across a GitHub organization.",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "SYNCMFST-002",
      "revision": 0,
      "state": "D",
      "body": "MUST be stored in a dedicated central repository (source of truth).",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "SYNCMFST-003",
      "revision": 0,
      "state": "D",
      "body": "MUST define at least one Template.",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "SYNCMFST-004",
      "revision": 0,
      "state": "D",
      "body": "MUST define a ComponentRegistry.",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "SYNCMFST-005",
      "revision": 0,
      "state": "A",
      "body": "HAS a manifest version in semver format.",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "SYNCMFST-006",
      "revision": 0,
      "state": "A",
      "body": "MUST be expressed as YAML named `steerspec-sync.yml` at the repository root.",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "SYNCMFST-007",
      "revision": 0,
      "state": "D",
      "body": "MAY define global template variables.",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "SYNCMFST-008",
      "revision": 0,
      "state": "D",
      "body": "HAS a Blake3 hash for integrity verification.",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    }
  ],
  "notes": [
    {
