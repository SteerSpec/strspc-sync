{
  "$schema": "./_schema/entity.v1.schema.json",
  "entity": {
    "id": "SYNCMFST",
    "title": "SyncManifest",
    "description": "The central configuration for synchronizing AI configuration files across a GitHub organization."
  },
  "rule_set": {
    "version": "0.6.1",
    "timestamp": "2026-11-26T14:12:14Z",
    "hash": "blake3:4ce33c9066e1955f4d2277ca6f0e9bbc94901d52b4d7160b466a00e0774f527b"
  },
  "rules": [
    {
      "id": "SYNCMFST-001",
      "revision": 0,
      "state": "D",
      "body": "IS the central configuration for synchronizing AI configuration files across a GitHub organization.",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "SYNCMFST-002",
      "revision": 0,
      "state": "D",
      "body": "MUST be stored in a dedicated central repository (source of truth).",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "SYNCMFST-003",
      "revision": 0,
      "state": "I",
      "body": "MUST define at least one Template.",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "SYNCMFST-004",
      "revision": 0,
      "state": "P",
      "body": "MUST define a ComponentRegistry.",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "SYNCMFST-005",
      "revision": 0,
      "state": "A",
      "body": "HAS a manifest version in semver format.",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "SYNCMFST-006",
      "revision": 0,
      "state": "A",
      "body": "MUST be expressed as YAML named `steerspec-sync.yml` at the repository root.",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "SYNCMFST-007",
      "revision": 0,
      "state": "I",
      "body": "MAY define global template variables.",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "SYNCMFST-008",
      "revision": 0,
      "state": "D",
      "body": "HAS a Blake3 hash for integrity verification.",
      "added_by": "github:pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "SYNCMFST-009",
      "revision": 0,
      "state": "D",
      "body": "MUST define a `targets` section with at least one `include` pattern selecting the target repositories.",
      "added_by": "github:pleberre",
      "added_at": "2026-11-26",
      "supersedes": "SYNCMFST-004"
    }
  ],
  "notes": [
    {
      "id": "SYNCMFST-005/01",
      "rule_ref": "SYNCMFST-005",
      "type": "deprecation_notice",
      "content": "Abandoned as a duplicate of SYNCCFG-003, which names the top-level version field of steerspec-sync.yml (GH #215).",
      "added_by": "github:pleberre",
      "added_at": "2026-11-12",
      "revision": 0
    },
    {
      "id": "SYNCMFST-006/01",
