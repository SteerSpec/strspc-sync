      "added_by": "@pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "SYNCMFST-002",
      "revision": 0,
      "state": "D",
      "body": "MUST be stored in a dedicated central repository (source of truth).",
      "added_by": "@pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "SYNCMFST-003",
      "revision": 0,
      "state": "D",
      "body": "MUST define at least one Template.",
      "added_by": "@pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "SYNCMFST-004",
      "revision": 0,
      "state": "D",
      "body": "MUST define a ComponentRegistry.",
      "added_by": "@pleberre",
      "added_at": "2026-03-07",
      "supersedes": null
    },
    {
      "id": "SYNCMFST-005",
      "revision": 0,
      "state": "D",
      "body": "HAS a manifest version in semver format.",
